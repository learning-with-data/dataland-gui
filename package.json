{
  "name": "dataland-gui",
  "version": "0.4.0",
  "description": "Editor for the DataLand project",
  "main": "dist/main.js",
  "scripts": {
    "build": "BUILD_TARGET=component vite build",
    "build-demo": "vite build",
    "start": "vite",
    "start:coverage": "VITE_COVERAGE=true vite",
    "lint": "eslint .",
    "prepare": "npm run build",
    "pretest": "rm -rf .nyc_output || true && rm -rf reports || true && npm run lint",
    "test": "vitest run --coverage && cypress run --browser chrome --headless",
    "test:unit": "vitest",
    "posttest": "npm run combine:reports",
    "cypress:open": "cypress open",
    "mkdir:reports": "mkdir reports || true",
    "precopy:reports": "npm run mkdir:reports",
    "copy:reports": "cp cypress-coverage/coverage-final.json reports/from-cypress.json && cp coverage/coverage-final.json reports/from-vitest.json",
    "precombine:reports": "npm run copy:reports && mkdir .nyc_output || true",
    "combine:reports": "nyc merge reports && mv coverage.json .nyc_output/out.json",
    "postcombine:reports": "nyc report"
  },
  "author": {
    "name": "Sayamindu Dasgupta",
    "email": "sayamindu@unc.edu"
  },
  "license": "BSD-3-Clause",
  "private": true,
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "cypress": "^15.20.1",
    "cypress-file-upload": "^5.0.8",
    "cypress-real-events": "^1.15.0",
    "eslint": "^10.8.1",
    "eslint-plugin-cypress": "^7.0.0",
    "eslint-plugin-react": "^7.37.5",
    "events": "^3.3.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "terser": "^5.50.0",
    "vite": "^8.2.1",
    "vite-plugin-arraybuffer": "^0.1.4",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@blockly/field-colour": "^13.2.0",
    "allotment": "^1.20.5",
    "blockly": "^13.2.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dataland-interpreter": "git+https://github.com/learning-with-data/dataland-interpreter.git#5816eb4124948cf1e437b7b2b5ab05ba45a45b89",
    "dayjs": "^1.11.23",
    "geolib": "^3.3.14",
    "immutable": "^5.1.9",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "pako": "^3.0.1",
    "papaparse": "^5.6.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-base-table": "^2.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-full-screen": "^1.1.1",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "react-vega": "^8.0.0",
    "redux": "^5.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "stats-lite": "^2.2.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xml2js": "^0.6.2"
  },
  "nyc": {
    "report-dir": "cypress-coverage"
  }
}
